{
  "description": "go-workflow: auto-format Go files after edits, and prevent loosening lint configs or adding //nolint without a reason (disable with hooks.formatOnEdit / hooks.protectConfig in .claude/go-workflow.json)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-config.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/format-on-edit.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
